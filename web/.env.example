# Bỏ trống để chạy bằng API giả (src/api/mock.ts). Điền khi backend đã deploy.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/v1
# Backend chạy local (backend/local/dev_server.py): VITE_API_BASE_URL=http://localhost:3001/v1

# Đăng nhập Cognito cho /admin và /kiosk (output UserPoolId, UserPoolClientId của stack).
# Bỏ trống thì tắt đăng nhập: chỉ dùng với API giả hoặc backend local.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
